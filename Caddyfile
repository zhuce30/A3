{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
		trusted_proxies_strict
	}
}

a3.zhuce.work {
	encode zstd gzip
	log_append visitor_ip {client_ip}
	log {
		output file /var/log/caddy/a3-access.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>Proxy-Authorization delete
				request>headers>X-CsrfToken delete
				request>headers>X-Csrftoken delete
			}
		}
	}
	@root path /
	redir @root /a3 308
	@realtime path /a3/realtime/ws
	reverse_proxy @realtime realtime-proxy:3003
	reverse_proxy frontend:3000
}

api.zhuce.work {
	encode zstd gzip
	log_append visitor_ip {client_ip}
	log {
		output file /var/log/caddy/api-access.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>Proxy-Authorization delete
				request>headers>X-CsrfToken delete
				request>headers>X-Csrftoken delete
			}
		}
	}
	reverse_proxy backend:8000
}

zhuce.work, www.zhuce.work {
	redir https://a3.zhuce.work{uri} 308
}
