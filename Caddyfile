a3.zhuce.work {
	encode zstd gzip
	@root path /
	redir @root /a3 308
	@realtime path /a3/realtime/ws
	reverse_proxy @realtime realtime-proxy:3003
	reverse_proxy frontend:3000
}

api.zhuce.work {
	encode zstd gzip
	reverse_proxy backend:8000
}

zhuce.work, www.zhuce.work {
	redir https://a3.zhuce.work{uri} 308
}
