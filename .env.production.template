COMPOSE_PROJECT_NAME=a3

# Required production secrets. Generate strong random values before deploying.
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
MYSQL_DATABASE=a3_learning
MYSQL_USER=a3
MYSQL_PASSWORD=change-me-mysql-password
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password

# Public domains.
DJANGO_ALLOWED_HOSTS=api.zhuce.work,localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=https://a3.zhuce.work,https://zhuce.work,https://www.zhuce.work
NEXT_PUBLIC_A3_API_BASE_URL=https://api.zhuce.work
# Resolve the full DEPLOY_SHA tag, verify its OCI revision, and store the verified RepoDigest.
# The digest is the immutable production identity; never switch production with latest.
A3_FRONTEND_IMAGE=ghcr.io/zhuce30/a3-frontend@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST

# First boot can seed demo data. Set to 0 after the first successful deployment if needed.
A3_SEED_DEMO_DATA=1

# Optional email/SMS/LLM/provider keys. Leave empty to use local fallback behavior where supported.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

A3_LLM_API_KEY=
A3_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
A3_LLM_MODEL=qwen-plus
A3_RESOURCE_LLM_ENABLED=auto
A3_RESOURCE_LLM_FULL_PACK_ENABLED=0

A3_GRAPH_LLM_API_KEY=
A3_WIKI_LLM_API_KEY=
A3_OCR_API_KEY=
A3_BAIDU_PADDLEOCR_TOKEN=

A3_COACHING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
A3_COACHING_API_KEY=
A3_COACHING_MODEL=qwen-plus
QWEN_API_KEY=
ASR_QWEN_API_KEY=

VIDEO_SEEDANCE_API_KEY=
VIDEO_SEEDANCE_BASE_URL=
