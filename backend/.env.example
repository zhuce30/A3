DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-before-deploy
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002
# Production subdomain sharing only. Leave these unset for local HTTP development.
# DJANGO_SESSION_COOKIE_NAME=a3_sessionid
# DJANGO_SESSION_COOKIE_DOMAIN=.example.com
# DJANGO_SESSION_COOKIE_SECURE=1

MYSQL_DATABASE=a3_learning
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

REDIS_URL=redis://127.0.0.1:6379/0
# Local Windows fallback without Redis:
# CELERY_BROKER_URL=filesystem://
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=cache+memory://
CELERY_TASK_TIME_LIMIT=14400
CELERY_TASK_SOFT_TIME_LIMIT=13800
CELERY_REDIS_VISIBILITY_TIMEOUT=18000
CELERY_BEAT_POLICY_OUTCOME_HOUR=3
CELERY_BEAT_POLICY_OUTCOME_MINUTE=15

# Server-only key for Qwen/DashScope narration in the dedicated video-worker.
# The worker also accepts TTS_QWEN_API_KEY, DASHSCOPE_API_KEY, QWEN_API_KEY, or A3_LLM_API_KEY.
A3_VIDEO_TTS_API_KEY=

# Production SMS gateway webhook. Receives
# { target, code, purpose, expiresIn } as JSON.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Email verification code delivery. For QQ Mail, EMAIL_HOST_PASSWORD must be
# the mailbox SMTP authorization code, not the normal login password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
EMAIL_HOST_USER=3062221819@qq.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=3062221819@qq.com

# Local development only. Keep 0 in staging/production.
VERIFICATION_CODE_DEV_MODE=0
VERIFICATION_CODE_DEV_VALUE=123456

KNOWLEDGE_UPLOAD_ROOT=D:\Download\A3\data\uploads
KNOWLEDGE_UPLOAD_MAX_BYTES=209715200

# A3 LLM gateway. DashScope uses an OpenAI-compatible endpoint.
A3_LLM_API_KEY=
A3_PERSONAL_QUESTION_LLM_TIMEOUT_SECONDS=35
A3_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
A3_LLM_MODEL=qwen-plus
A3_LLM_TIMEOUT_SECONDS=12
# Resource generation uses structured LLM synthesis when a key is configured.
# auto enables it outside tests; set 0 to force deterministic local fallback.
A3_RESOURCE_LLM_ENABLED=auto
# Full-pack generation contains seven resource types. Keep this off by default to avoid a long synchronous request.
A3_RESOURCE_LLM_FULL_PACK_ENABLED=0
A3_RESOURCE_LLM_TIMEOUT_SECONDS=90
A3_RESOURCE_LLM_MAX_TOKENS=3600
# Optional material knowledge graph extraction. If the graph-specific key is empty, it can fall back to A3_LLM_API_KEY.
# The builder extracts entities/relations from parsed chunks and requires source-bound evidenceBlockIds.
A3_GRAPH_LLM_PROVIDER=dashscope
A3_GRAPH_LLM_API_KEY=
A3_GRAPH_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
A3_GRAPH_LLM_MODEL=qwen-plus
# LightRAG-style follow-up extraction passes over the same chunks. Valid range: 0-2.
# Default to the maximum supported rounds so uploaded materials do not stop at a sparse first-pass graph.
A3_GRAPH_LLM_GLEANING_ROUNDS=2
A3_GRAPH_LLM_MAX_TOKENS=4096
A3_GRAPH_LLM_REPAIR_MAX_TOKENS=4096
A3_GRAPH_LLM_GLEANING_MAX_TOKENS=4096
# Material knowledge graph extraction can process large uploaded files, so keep this higher than chat tutoring.
A3_GRAPH_LLM_TIMEOUT_SECONDS=3600
# Optional Wiki term/definition extraction for uploaded knowledge-base materials.
# If A3_WIKI_LLM_API_KEY is empty, Wiki builder falls back to graph entities + rule-based definition extraction.
# Provider-specific values are mapped to the shared OpenAI-compatible A3_LLM_* gateway only inside the Wiki builder.
A3_WIKI_LLM_PROVIDER=dashscope
A3_WIKI_LLM_API_KEY=
A3_WIKI_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
A3_WIKI_LLM_MODEL=qwen-plus
A3_WIKI_LLM_TIMEOUT_SECONDS=3600

# Multimodal OCR/VLM for uploaded images, rendered PDF pages, and PPTX slides.
# local/rapidocr: local OCR fallback; none: disable OCR.
# qwen_ocr: Alibaba Cloud DashScope Qwen-OCR provider for document OCR.
# baidu_paddleocr_vl: Baidu AI Studio PaddleOCR-VL async document parser.
# openai_vision/qwen_vl/doubao_vl: generic OpenAI-compatible vision endpoint.
A3_OCR_PROVIDER=baidu_paddleocr_vl
A3_OCR_API_KEY=
A3_OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
A3_OCR_MODEL=qwen-vl-ocr-latest
A3_OCR_API_TIMEOUT_SECONDS=120
A3_BAIDU_PADDLEOCR_TOKEN=
A3_BAIDU_PADDLEOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
A3_BAIDU_PADDLEOCR_MODEL=PaddleOCR-VL-1.6
A3_BAIDU_PADDLEOCR_TIMEOUT_SECONDS=360
A3_BAIDU_PADDLEOCR_POLL_INTERVAL_SECONDS=5
A3_BAIDU_PADDLEOCR_RETRY_EMPTY=1
A3_PDF_RENDER_MAX_PAGES=120
A3_PPTX_RENDER_MAX_SLIDES=120
A3_PPTX_OCR_MAX_SLIDES=40
A3_PPTX_OCR_TEXT_SLIDES=0

# A3 Agent runtime governance.
# Recent trace window used by active circuit breaking.
A3_AGENT_CIRCUIT_RECENT_LIMIT=12
# Minimum workflow/agent samples before a circuit can open.
A3_AGENT_CIRCUIT_MIN_SAMPLES=3
# Failure rate threshold. 0.5 means open when recent failures reach 50%.
A3_AGENT_CIRCUIT_OPEN_THRESHOLD=0.5

# Per-agent retry and timeout policies (override agent-class defaults).
# MAX_RETRIES: number of extra attempts after first failure (0 = no retry).
# TIMEOUT_MS: per-step wall-clock deadline in milliseconds (0 or unset = no timeout).
A3_PROFILE_AGENT_MAX_RETRIES=1
A3_PROFILE_AGENT_TIMEOUT_MS=2500
A3_PLANNER_AGENT_MAX_RETRIES=1
A3_PLANNER_AGENT_TIMEOUT_MS=5000
A3_RETRIEVER_AGENT_MAX_RETRIES=1
A3_RETRIEVER_AGENT_TIMEOUT_MS=3000
A3_VERIFIER_AGENT_MAX_RETRIES=1
A3_VERIFIER_AGENT_TIMEOUT_MS=3000
A3_ASSESSMENT_AGENT_MAX_RETRIES=0
A3_ASSESSMENT_AGENT_TIMEOUT_MS=2000
A3_STUDY_PLAN_AGENT_MAX_RETRIES=1
A3_STUDY_PLAN_AGENT_TIMEOUT_MS=4000
